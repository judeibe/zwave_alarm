# Serial device path for the Z-Wave USB controller.
# In Docker this is the in-container target from docker-compose.yml's `devices` mapping (/dev/zwave);
# on bare metal use the controller's stable by-id path (e.g. /dev/serial/by-id/usb-Some_Controller-if00).
SERIAL_PORT=/dev/ttyACM0

# Filesystem path to the SQLite database file (created automatically on first run).
DB_PATH=./data/alarm.db

# Port the REST API and WebSocket push channel (src/api) listen on.
HTTP_PORT=3000

# Port zwave-js-server listens on. Home Assistant's built-in "Z-Wave JS" integration connects here directly.
ZWAVE_SERVER_PORT=3001

# Secret used to sign session cookies for the native web dashboard. Set a long, random value.
SESSION_SECRET=change-me-to-a-long-random-string
