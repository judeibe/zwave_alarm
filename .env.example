# Serial device path for the Z-Wave USB controller.
# In Docker this is the in-container target from docker-compose.yml's `devices` mapping (/dev/zwave);
# on bare metal use the controller's stable by-id path (e.g. /dev/serial/by-id/usb-Some_Controller-if00).
SERIAL_PORT=/dev/ttyACM0

# Filesystem path to the SQLite database file (created automatically on first run).
DB_PATH=./data/alarm.db

# Port the REST API and WebSocket push channel (src/api) listen on.
HTTP_PORT=3000

# Port zwave-js-server listens on. Home Assistant's built-in "Z-Wave JS" integration connects here directly.
ZWAVE_SERVER_PORT=3001

# Optional: host/interface zwave-js-server binds to. Defaults to 0.0.0.0 (all interfaces) so it's
# reachable from Home Assistant over the local network; it does not need to be exposed to the internet.
#ZWAVE_SERVER_HOST=0.0.0.0

# Secret used to sign session cookies for the native web dashboard. Must be at least 32 characters and
# not this placeholder, or the service will refuse to start. Generate one: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: Z-Wave node id of the paired siren/alert device (FR-013). Leave unset until one is
# paired and included on the network; the alarm still functions without it, just silently.
#SIREN_NODE_ID=5

# Optional: exit delay (seconds between arming and the panel becoming armed, so you can leave) and entry
# delay (seconds between a breach and the alarm triggering, so you can disarm). Whole seconds, 0-600,
# default 30 each. One value applies to the whole panel. Life-safety sensors always trigger immediately.
#EXIT_DELAY_SECONDS=30
#ENTRY_DELAY_SECONDS=30

# Optional: minimum level written to the JSON logs: debug | info | warn | error (default info).
# `debug` adds per-node Z-Wave value/notification changes and is chatty on a busy network.
#LOG_LEVEL=info

# Optional: Z-Wave network security keys, 32 hex characters (16 bytes) each. Set the same keys you used when
# the devices were included, or they will not be able to talk to the controller. Generate: openssl rand -hex 16
# Keep them out of git; on the Proxmox VM they live in /opt/zwave-alarm/.env.
#ZWAVE_KEY_S2_UNAUTHENTICATED=
#ZWAVE_KEY_S2_AUTHENTICATED=
#ZWAVE_KEY_S2_ACCESS_CONTROL=
#ZWAVE_KEY_S0_LEGACY=
#ZWAVE_LR_KEY_S2_AUTHENTICATED=
#ZWAVE_LR_KEY_S2_ACCESS_CONTROL=
